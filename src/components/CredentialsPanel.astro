---
import { client } from "../lib/client";

const c = client.credentials;
const licenseKindLabel = c.license.registrationLabel === "rpps" ? "RPPS" : "ADELI";
const hasCredentials = Boolean(
  c.license.rppsOrAdeli ||
  typeof c.experienceYears === "number" ||
  c.experiences.length ||
  c.degrees.length ||
  c.trainings.length ||
  c.affiliations.length,
);
---

{
  hasCredentials && (
    <section data-component="panel.credentials" aria-labelledby="about-credentials-title">
      <h2 id="about-credentials-title">Parcours et qualifications</h2>
      {(typeof c.experienceYears === "number" || c.license.rppsOrAdeli) && (
        <dl data-component="credentials.facts">
          {typeof c.experienceYears === "number" && (
            <div>
              <dt>Expérience</dt>
              <dd>
                {c.experienceYears} {c.experienceYears === 1 ? "an" : "ans"}
              </dd>
            </div>
          )}
          {c.license.rppsOrAdeli && (
            <div>
              <dt>Inscription {licenseKindLabel}</dt>
              <dd>
                <bdi>{c.license.rppsOrAdeli}</bdi>
              </dd>
            </div>
          )}
        </dl>
      )}

      {c.experiences.length > 0 && (
        <section data-component="credentials.experiences" aria-labelledby="about-experiences-title">
          <h3 id="about-experiences-title">Expériences professionnelles</h3>
          <ul>
            {c.experiences.map((item) => (
              <li>
                {item.period && <p data-component="credentials.period">{item.period}</p>}
                <p data-component="credentials.item-title">{item.label}</p>
                {item.organization && <p>{item.organization}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {c.degrees.length > 0 && (
        <section data-component="credentials.degrees" aria-labelledby="about-degrees-title">
          <h3 id="about-degrees-title">Diplômes</h3>
          <ul>
            {c.degrees.map((item) => (
              <li>
                {item.year && <p data-component="credentials.period">{item.year}</p>}
                <p data-component="credentials.item-title">{item.label}</p>
                {item.institution && <p>{item.institution}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {c.trainings.length > 0 && (
        <section data-component="credentials.trainings" aria-labelledby="about-trainings-title">
          <h3 id="about-trainings-title">Formations continues</h3>
          <ul>
            {c.trainings.map((item) => (
              <li>
                {item.year && <p data-component="credentials.period">{item.year}</p>}
                <p data-component="credentials.item-title">{item.label}</p>
                {item.provider && <p>{item.provider}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {c.affiliations.length > 0 && (
        <section
          data-component="credentials.affiliations"
          aria-labelledby="about-affiliations-title"
        >
          <h3 id="about-affiliations-title">Affiliations professionnelles</h3>
          <ul>
            {c.affiliations.map((affiliation) => (
              <li>{affiliation}</li>
            ))}
          </ul>
        </section>
      )}
    </section>
  )
}
